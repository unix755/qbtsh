#!/bin/sh /etc/rc.common

START=90
STOP=01
USE_PROCD=1

service_data() {
  echo "qbittorrent is starting up..."
}

start_service() {
  procd_open_instance
  procd_set_param command /usr/local/bin/qbittorrent-nox
  procd_append_param command --profile="/usr/local/etc/"
  procd_set_param pidfile /var/run/qbittorrent.pid
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
