#!/bin/sh

# PROVIDE: qbittorrent
# REQUIRE: DAEMON

. /etc/rc.subr

name=qbittorrent
rcvar=${name}_enable
command="/usr/local/bin/${name}-nox"
pidfile="/var/run/${name}.pid"
start_cmd="${name}_start"
qbittorrent_start() {
  echo "Starting ${name}."
  /usr/sbin/daemon -cf -p ${pidfile} ${command} --profile="/usr/local/etc/"
}
load_rc_config $name
run_rc_command "$1"